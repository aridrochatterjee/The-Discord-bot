
DISCORD_TOKEN=

# =============================================================================
# Horizon Devs Discord Bot — Environment Configuration Template
# 
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# =============================================================================

# [REQUIRED] Discord Bot Token
# Get yours from: https://discord.com/developers/applications

# [DATABASE] Supabase Configuration
# Required for database-backed features (reputation karma & project showcases)
# Project Settings -> API in Supabase Dashboard
SUPABASE_URL=
SUPABASE_KEY=
# [DATABASE OPTIONAL] Direct PostgreSQL Connection URI
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:6543/postgres

# [CODE EXECUTION] Piston Sandbox API
# Public Piston endpoint or your self-hosted instance (e.g., http://localhost:2000/api/v2/piston)
PISTON_URL=
PISTON_API_KEY=

OPENAI_API_KEY=
GROQ_API_KEY=