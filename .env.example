# =============================================================================
# Horizon Devs Discord Bot — Environment Configuration Template
# 
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# =============================================================================

# [REQUIRED] Discord Bot Token
# Get yours from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# [DATABASE] Supabase Configuration
# Required for database-backed features (reputation karma & project showcases)
# Project Settings -> API in Supabase Dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# [DATABASE OPTIONAL] Direct PostgreSQL Connection URI
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:6543/postgres

# [CODE EXECUTION] Judge0 CE Configuration
# Option A: RapidAPI Free Tier (50 free runs/day)
# Get a free key at: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here

# Option B: Self-Hosted Judge0 via Docker (100% Free & Unlimited)
# docker run -d -p 2358:2358 judge0/judge0
# JUDGE0_URL=http://localhost:2358
# RAPIDAPI_KEY=
